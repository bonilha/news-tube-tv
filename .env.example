ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# OBS WebSocket (obs-websocket v5, port 4455)
OBS_WS_URL=ws://localhost:4455
OBS_WS_PASSWORD=

# Video settings
OBS_BASE_WIDTH=1920
OBS_BASE_HEIGHT=1080
OBS_FPS_NUM=30000
OBS_FPS_DEN=1001

# RTMP output (configured in OBS Studio)
RTMP_URL=rtmp://localhost/live
RTMP_KEY=stream_key

# URL the OBS browser source opens for the lower-third QR. Use this PC's address when OBS is elsewhere.
OVERLAY_BASE_URL=http://127.0.0.1:8000

# Invidious instance used to resolve channels and list videos
INVIDIOUS_URL=http://127.0.0.1:3000

# Title language requested from Invidious (YouTube hl code)
CONTENT_LANGUAGE=pt-BR

# Scan active channels and expire queued videos. 0 runs only on startup, buttons, and new channels.
QUEUE_REFRESH_MINUTES=15

# Top up the MP4 buffer so five unplayed files stay ready. 0 disables only this loop.
QUEUE_BUFFER_MINUTES=5

# Browser cookie export (JSON or Netscape). Required before any yt-dlp download.
COOKIES_DIR=cookies

# yt-dlp MP4s. Only the first N pending/playing videos stay on disk.
VIDEOS_DIR=videos
QUEUE_DOWNLOAD_KEEP=5
# Skip a new download when free space is below this many megabytes.
QUEUE_MIN_FREE_MB=1024
